# ==========================================
# JANSEVA DJANGO BACKEND - PRODUCTION ENVIRONMENT VARIABLES
# ==========================================

# Core Django Security
SECRET_KEY=your-production-secret-key-change-this-in-prod
DEBUG=False
ALLOWED_HOSTS=janseva-backend.onrender.com,localhost,127.0.0.1

# Database Configuration (Supabase PostgreSQL / Neon / Railway PostgreSQL)
SUPABASE_DB_URL=postgresql://postgres.xxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Email Provider Configuration (Brevo HTTP API / SMTP)
BREVO_API_KEY=xkeysib-your-brevo-api-key
DEFAULT_FROM_EMAIL=official@janseva.gov.in

# AI Vision & Diagnostics (Google Gemini API)
GEMINI_API_KEY=your-google-gemini-api-key

# Production Frontend URL for CORS
FRONTEND_URL=https://janseva.vercel.app
